# Copy to .env for local development. Every value here is read by
# src/core/config.py, which documents the rest (and why each default exists).
# SLURM jobs set LLM_PROVIDER/VLLM_MODEL themselves; see docs/NARVAL_SETUP.md.

# --- LLM backend ------------------------------------------------------------
# ollama = local dev, vllm = batched GPU inference on Narval
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Per-stage generation budgets. Never lower these to one global value: a single
# 512-token budget once truncated 96% of extractions into schema fallback.
EXTRACTION_MAX_TOKENS=2048
CRITIQUE_MAX_TOKENS=1536
ALIGNMENT_MAX_TOKENS=256
MCQ_MAX_TOKENS=512

# --- Corpus build -----------------------------------------------------------
DATASET_NAME=culturebank
DEFAULT_SPLIT=train
CORPUS_LIMIT=2000
CORPUS_BATCH_SIZE=32

# auto = sentence-transformers if installed, else TF-IDF.
# tfidf = fast and deterministic (use for tests; MiniLM loads slowly from Lustre).
EMBEDDING_BACKEND=auto

# --- Retrieval / evaluation -------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.15
RANDOM_SEED=42

# --- Legacy MVP path only (scripts/legacy/) ----------------------------------
DEFAULT_LIMIT=100
USE_LLM_EXTRACTION=true
USE_LLM_CRITIQUE=true
USE_LLM_ANSWERS=true
USE_LLM_EVALUATION=false
